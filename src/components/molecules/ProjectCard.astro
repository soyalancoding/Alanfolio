---
// Components
import Typography from "@/components/atoms/Typography.astro";
import OptimizedImage from "@/components/atoms/OptimizedImage.astro";
import Icon from "@/components/atoms/Icon.astro";
import Anchor from "@/components/atoms/Anchor.astro";

// Interfaces
interface Props {
  title: string;
  shortDescription: string;
  imageUrl: string;
  slug: string;
  techStack: string[];
}

const { title, shortDescription, imageUrl, slug, techStack } = Astro.props;
---

<div
  class="group glass-card rounded-xl overflow-hidden ghost-border hover:-translate-y-2 transition-all duration-300"
>
  <div class="relative h-64 overflow-hidden">
    <div
      class="absolute inset-0 bg-linear-to-t from-brand-surface to-transparent z-10 opacity-60"
    >
    </div>
    <OptimizedImage
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
      alt={title}
      src={imageUrl || "/placeholder.png"}
    />
    <div class="absolute bottom-4 left-4 z-20 flex flex-wrap gap-2">
      {
        techStack
          .slice(0, 2)
          .map((tech) => (
            <span class="px-3 py-1 rounded-full bg-brand-surface/80 backdrop-blur-md text-brand-primary font-mono text-xs">
              {tech}
            </span>
          ))
      }
    </div>
  </div>
  <div class="p-8">
    <Typography
      variant="h3"
      className="mb-3 group-hover:text-brand-primary transition-colors"
    >
      {title}
    </Typography>
    <Typography variant="body" className="mb-6 line-clamp-2">
      {shortDescription}
    </Typography>
    <div class="flex items-center justify-between">
      <Anchor
        className="font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-2 text-brand-text hover:text-brand-primary"
        href={`/projects/${slug}`}
      >
        Ver proyecto
        <Icon name="lucide:external-link" size="sm" />
      </Anchor>
      <div
        class="text-brand-textMuted opacity-0 group-hover:opacity-100 transition-opacity"
      >
        <Icon name="lucide:arrow-right" size="md" />
      </div>
    </div>
  </div>
</div>
