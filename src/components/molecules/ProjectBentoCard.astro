---
// Components
import Typography from "@/components/atoms/Typography.astro";
import Icon from "@/components/atoms/Icon.astro";
import OptimizedImage from "@/components/atoms/OptimizedImage.astro";
import Anchor from "@/components/atoms/Anchor.astro";
import type { ImageMetadata } from "astro";

// Interfaces
import type { ProjectData } from "@/interfaces/ProjectData";

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/projects/*.{jpeg,jpg,png,gif,webp}",
  { eager: true },
);

const isRemote = project.imageUrl?.startsWith("http");
let imageSource: string | ImageMetadata = project.imageUrl || "";

if (!isRemote && project.imageUrl) {
  if (images[project.imageUrl]) {
    imageSource = images[project.imageUrl].default;
  } else {
    console.warn(`Image not found in glob: ${project.imageUrl}`);
  }
}

// Determinar el diseño basado en el colSpan y categoría (específico del diseño Stitch)
const isRowLayout =
  project.colSpan === "md:col-span-8" && project.category === "ai";
const isFeaturedLayout =
  project.colSpan === "md:col-span-8" && project.category === "webgl";
const isHalfLayout = project.colSpan === "md:col-span-6";

let imageContainerClass = "overflow-hidden relative ";
if (isRowLayout) {
  imageContainerClass += "md:w-2/5";
} else if (isFeaturedLayout) {
  imageContainerClass += "relative aspect-video";
} else if (isHalfLayout) {
  imageContainerClass += "h-64";
} else {
  imageContainerClass += "h-48 bg-brand-surfaceContainerHigh";
}

let cardClass = "glass-card rounded-xl overflow-hidden h-full flex flex-col";
if (isRowLayout) {
  cardClass += " md:flex-row";
}
---

<article
  class={`project-grid-item animate-fade-in ${project.colSpan} group`}
  data-category={project.category}
>
  <Anchor
    href={`/projects/${project.slug}`}
    className="block h-full cursor-pointer"
    variant="wrapper"
  >
    <div class={cardClass}>
      <div class={imageContainerClass}>
        {
          project.isFeatured && (
            <div class="absolute inset-0 bg-linear-to-t from-brand-background to-transparent z-10 opacity-60" />
          )
        }
        {
          imageSource && (
            <OptimizedImage
              src={imageSource}
              alt={project.imageAlt || project.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
          )
        }
        {
          project.isFeatured && (
            <div class="absolute top-4 left-4 z-20">
              <Typography
                variant="span"
                className="bg-brand-primary/20 backdrop-blur-md text-brand-primary font-mono text-xs px-3 py-1 rounded border border-brand-primary/30"
              >
                DESTACADO
              </Typography>
            </div>
          )
        }
      </div>

      <div
        class={`p-6 md:p-8 flex flex-col justify-center ${isRowLayout ? "md:w-3/5" : ""}`}
      >
        <div class="flex justify-between items-start mb-4">
          <Typography variant="h3" className="text-brand-onSurface m-0">
            {project.title}
          </Typography>
          {
            project.icon && (
              <div class="text-brand-primary group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">
                <Icon name={project.icon} size="md" />
              </div>
            )
          }
        </div>
        <Typography variant="body" className="text-brand-textMuted mb-6">
          {project.description}
        </Typography>
        <div class="flex flex-wrap gap-2">
          {
            project.techStack.map((tech) => (
              <Typography
                variant="span"
                className="bg-brand-surfaceContainerHighest text-brand-secondary font-mono text-xs px-3 py-1 rounded-full"
              >
                {tech}
              </Typography>
            ))
          }
        </div>
      </div>
    </div>
  </Anchor>
</article>
