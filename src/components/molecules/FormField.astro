---
import Typography from "../atoms/Typography.astro";

interface Props {
  label: string;
  id?: string;
  name?: string;
  type?: "text" | "email" | "password" | "number" | "textarea";
  placeholder?: string;
  rows?: number;
  required?: boolean;
}

const {
  label,
  id,
  name,
  type = "text",
  placeholder,
  rows = 4,
  required,
} = Astro.props;

const baseInputClasses =
  "w-full bg-brand-surfaceHighlight border border-brand-border/50 rounded-lg p-4 focus:outline-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all text-brand-text placeholder:opacity-30";
---

<div class="space-y-2">
  <Typography variant="label-muted">{label}</Typography>

  {
    type === "textarea" ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        placeholder={placeholder}
        required={required}
        class={baseInputClasses}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        placeholder={placeholder}
        required={required}
        class={baseInputClasses}
      />
    )
  }
</div>
