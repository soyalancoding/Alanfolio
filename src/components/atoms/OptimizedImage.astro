---
// External Libraries
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Interfaces
interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className,
  loading = "lazy",
  width,
  height,
} = Astro.props;

const isRemote =
  typeof src === "string" &&
  (src.startsWith("http://") || src.startsWith("https://"));
const isLocalImport = typeof src !== "string";

const finalWidth = width || (isRemote ? 800 : undefined);
const finalHeight = height || (isRemote ? 600 : undefined);
---

{
  isLocalImport ? (
    <Image
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      width={width}
      height={height}
    />
  ) : finalWidth && finalHeight ? (
    <Image
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      width={finalWidth}
      height={finalHeight}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      inferSize={true}
      width={finalWidth}
      height={finalHeight}
    />
  )
}
