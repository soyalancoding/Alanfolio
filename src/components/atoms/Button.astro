---
import Anchor from "@/components/atoms/Anchor.astro";

// Interfaces
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "cta" | "outline";
  size?: "sm" | "md" | "lg";
  shape?: "rounded" | "pill" | "lg";
  href?: string;
  className?: string;
  type?: "button" | "submit" | "reset";
  target?: string;
  rel?: string;
}

const {
  variant = "primary",
  size = "md",
  shape = "rounded",
  href,
  className = "",
  type = "button",
  target,
  rel,
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-bold transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 focus:ring-offset-brand-background active:scale-95 text-center";

const sizes = {
  sm: "px-6 py-2 text-xs",
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
};

const shapes = {
  rounded: "rounded",
  pill: "rounded-full",
  lg: "rounded-lg",
};

const variants = {
  primary:
    "bg-gradient-to-r from-brand-primary to-[#c3f5ff] text-brand-background hover:brightness-110 shadow-[0_0_15px_rgba(0,229,255,0.3)]",
  secondary: "bg-brand-secondary text-brand-background hover:brightness-110",
  ghost:
    "bg-transparent border border-brand-primary text-brand-primary hover:bg-brand-primary/10",
  cta: "cyan-orange-gradient text-brand-surface hover:shadow-[0_0_20px_rgba(0,218,243,0.4)]",
  outline:
    "bg-transparent border border-brand-primary/40 text-brand-primary hover:bg-brand-primary/10",
};

const classes =
  `${baseStyles} ${sizes[size]} ${shapes[shape]} ${variants[variant]} ${className}`.trim();

const resolvedRel = target === "_blank" && !rel ? "noopener noreferrer" : rel;
---

{
  href ? (
    <Anchor href={href} className={classes} target={target} rel={resolvedRel}>
      <slot />
    </Anchor>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
