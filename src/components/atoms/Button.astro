---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  className?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', href, className = '', type = 'button' } = Astro.props;

const baseStyles = "inline-flex items-center justify-center px-6 py-3 rounded text-sm font-medium transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 focus:ring-offset-brand-background";

const variants = {
  primary: "bg-gradient-to-r from-brand-primary to-[#c3f5ff] text-brand-background hover:brightness-110 shadow-[0_0_15px_rgba(0,229,255,0.3)]",
  secondary: "bg-brand-secondary text-brand-background hover:brightness-110",
  ghost: "bg-transparent border border-brand-primary text-brand-primary hover:bg-brand-primary/10",
};

const classes = `${baseStyles} ${variants[variant]} ${className}`.trim();
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
