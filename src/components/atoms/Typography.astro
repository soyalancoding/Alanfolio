---
// Interfaces
interface Props {
  variant?:
    | "h1"
    | "h2"
    | "h3"
    | "body"
    | "body-lg"
    | "body-sm"
    | "label"
    | "label-muted"
    | "code"
    | "span";
  className?: string;
}

const { variant = "body", className = "" } = Astro.props;

const styles = {
  h1: "font-geist text-4xl md:text-5xl font-extrabold tracking-tight leading-tight",
  h2: "font-geist text-2xl md:text-3xl font-bold tracking-tight",
  h3: "font-geist text-lg md:text-xl font-bold",
  body: "font-inter text-sm md:text-base font-normal text-brand-textMuted leading-relaxed",
  "body-lg":
    "font-inter text-lg font-normal text-brand-textMuted leading-relaxed",
  "body-sm":
    "font-inter text-xs font-normal text-brand-textMuted leading-relaxed",
  label: "font-mono text-xs uppercase tracking-wider text-brand-primary",
  "label-muted":
    "font-mono text-xs uppercase tracking-wider text-brand-textMuted",
  code: "font-mono text-xs font-medium bg-brand-surfaceHighlight px-2 py-1 rounded text-brand-primary",
  span: "inherit",
};

const Tag = ["h1", "h2", "h3"].includes(variant)
  ? variant
  : variant === "code"
    ? "code"
    : variant === "label" || variant === "label-muted" || variant === "span"
      ? "span"
      : "p";
const classes = `${styles[variant]} ${className}`.trim();
---

<Tag class={classes}>
  <slot />
</Tag>
