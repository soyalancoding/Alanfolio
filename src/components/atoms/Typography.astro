---
interface Props {
  variant?: 'h1' | 'h2' | 'h3' | 'body' | 'label' | 'code';
  className?: string;
}

const { variant = 'body', className = '' } = Astro.props;

const styles = {
  h1: "font-geist text-5xl md:text-6xl font-extrabold tracking-tight leading-tight",
  h2: "font-geist text-3xl md:text-4xl font-bold tracking-tight",
  h3: "font-geist text-xl md:text-2xl font-bold",
  body: "font-inter text-base md:text-lg font-normal text-brand-textMuted leading-relaxed",
  label: "font-mono text-xs md:text-sm uppercase tracking-wider text-brand-primary",
  code: "font-mono text-sm font-medium bg-brand-surfaceHighlight px-2 py-1 rounded text-brand-primary",
};

const Tag = ['h1', 'h2', 'h3'].includes(variant) ? variant : (variant === 'code' ? 'code' : (variant === 'label' ? 'span' : 'p'));
const classes = `${styles[variant]} ${className}`.trim();
---

<Tag class={classes}>
  <slot />
</Tag>
