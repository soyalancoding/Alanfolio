---
// Components
import Typography from "@/components/atoms/Typography.astro";
import TechCard from "@/components/molecules/TechCard.astro";

// Data
import skillsData from "@/data/skills.json";
---

<section class="max-w-6xl mx-auto px-6 py-16 md:py-32">
  <div class="flex flex-col md:flex-row items-end justify-between gap-8 mb-16">
    <div>
      <Typography variant="h2" className="mb-4">
        Tech <Typography variant="span" className="text-brand-primary"
          >Stack</Typography
        >
      </Typography>
      <Typography variant="body" className="max-w-md">
        Las herramientas y lenguajes que utilizo para crear experiencias
        digitales de vanguardia.
      </Typography>
    </div>
    <div class="h-px flex-1 bg-brand-border/20 mb-4 hidden md:block"></div>
  </div>

  <div class="space-y-16">
    <!-- Frontend -->
    <div>
      <Typography variant="h3" className="mb-8 text-brand-secondary">
        Frontend
      </Typography>
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6"
      >
        {
          skillsData.frontend.map((skill: { name: string; icon: string }) => (
            <TechCard name={skill.name} icon={skill.icon} />
          ))
        }
      </div>
    </div>

    <!-- Backend -->
    <div>
      <Typography variant="h3" className="mb-8 text-brand-primary">
        Backend y bases de datos
      </Typography>
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6"
      >
        {
          skillsData.backend.map((skill: { name: string; icon: string }) => (
            <TechCard name={skill.name} icon={skill.icon} />
          ))
        }
      </div>
    </div>

    <!-- Tools -->
    <div>
      <Typography variant="h3" className="mb-8 text-brand-text">
        DevOps y herramientas
      </Typography>
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6"
      >
        {
          skillsData.tools.map((skill: { name: string; icon: string }) => (
            <TechCard name={skill.name} icon={skill.icon} />
          ))
        }
      </div>
    </div>
  </div>
</section>
