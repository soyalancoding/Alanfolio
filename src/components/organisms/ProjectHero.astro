---
// Components
import Typography from "@/components/atoms/Typography.astro";
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import OptimizedImage from "@/components/atoms/OptimizedImage.astro";
import type { ImageMetadata } from "astro";

// Interfaces
import type { ProjectData } from "@/interfaces/ProjectData";

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/projects/*.{jpeg,jpg,png,gif,webp}",
  { eager: true },
);

const isRemote = project.imageUrl?.startsWith("http");
let imageSource: string | ImageMetadata = project.imageUrl || "";

if (!isRemote && project.imageUrl) {
  if (images[project.imageUrl]) {
    imageSource = images[project.imageUrl].default;
  } else {
    console.warn(`Image not found in glob: ${project.imageUrl}`);
  }
}
---

<section class="relative px-6 py-24 md:py-32 max-w-6xl mx-auto z-10">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-5 space-y-8">
      <div>
        <Typography
          variant="label"
          className="text-brand-primary uppercase tracking-widest block"
        >
          Caso de estudio
        </Typography>
        <Typography variant="h1" className="mt-4 text-gradient">
          {project.title}
        </Typography>
        <Typography
          variant="body-lg"
          className="text-brand-textMuted mt-6 leading-relaxed max-w-lg"
        >
          {project.shortDescription}
        </Typography>
      </div>
      <div class="flex flex-wrap gap-4">
        {
          project.liveUrl !== "#" && (
            <Button
              href={project.liveUrl}
              variant="cta"
              size="lg"
              shape="lg"
              className="flex items-center gap-2"
              target="_blank"
            >
              <Icon name="lucide:rocket" size="sm" />
              Live Demo
            </Button>
          )
        }
        {
          project.githubUrl !== "#" && (
            <Button
              href={project.githubUrl}
              variant="outline"
              size="lg"
              shape="lg"
              className="flex items-center gap-2"
              target="_blank"
            >
              <Icon name="lucide:code" size="sm" />
              View GitHub
            </Button>
          )
        }
      </div>
    </div>
    <div class="lg:col-span-7">
      <div
        class="relative rounded-2xl overflow-hidden glass-card p-2 shadow-2xl transition-all duration-700 opacity-100 translate-y-0"
      >
        {
          imageSource && (
            <OptimizedImage
              src={imageSource}
              alt={project.imageAlt || project.title}
              class="w-full aspect-video object-cover rounded-xl"
            />
          )
        }
        <div
          class="absolute inset-0 bg-linear-to-t from-brand-background/40 to-transparent pointer-events-none"
        >
        </div>
      </div>
    </div>
  </div>
</section>
