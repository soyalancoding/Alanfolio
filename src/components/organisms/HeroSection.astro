---
// External Libraries
import { Image } from "astro:assets";
// Components
import Typography from "@/components/atoms/Typography.astro";
import Button from "@/components/atoms/Button.astro";
// Data
import portfolioData from "@/data/portfolio.json";
// Assets
import profileImage from "@/assets/images/profile.webp";

const { profile } = portfolioData;
---

<section
  class="relative min-h-screen flex flex-col items-center justify-center pt-32 pb-32 overflow-hidden px-6"
>
  <!-- Background Glows -->
  <div
    class="absolute top-1/4 -left-20 w-96 h-96 bg-brand-primary/10 blur-[120px] rounded-full pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-1/4 -right-20 w-96 h-96 bg-brand-secondary/5 blur-[120px] rounded-full pointer-events-none"
  >
  </div>

  <div
    class="max-w-5xl mx-auto text-center z-10 flex-1 flex flex-col items-center justify-center w-full mb-12"
  >
    <div class="mb-10 hero-motion inline-block mt-12 md:mt-0">
      <Image
        src={profileImage}
        alt={profile.name}
        class="w-56 h-56 md:w-72 md:h-72 object-cover rounded-2xl border-4 border-brand-primary/40 shadow-[0_0_30px_rgba(0,218,243,0.3)] mx-auto"
      />
    </div>

    <Typography variant="h1" className="text-brand-text mb-6 animate-fade-in">
      Software Solutions <span class="text-gradient block md:inline"
        >Development</span
      >
    </Typography>

    <Typography variant="body" className="max-w-2xl mx-auto mb-10">
      {profile.bio}
    </Typography>

    <div
      class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full sm:w-auto"
    >
      <Button
        href="projects"
        variant="cta"
        size="lg"
        shape="pill"
        className="w-full sm:w-auto"
      >
        Ver proyectos
      </Button>
      <Button
        href="/resume.pdf"
        variant="outline"
        size="lg"
        shape="pill"
        className="w-full sm:w-auto"
      >
        Descargar CV
      </Button>
    </div>
  </div>

  <!-- Scroll Indicator (Oculto en móviles para evitar solapamientos) -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 opacity-40 hidden md:flex"
  >
    <span
      class="font-mono text-sm tracking-widest text-brand-textMuted uppercase"
      >Scroll</span
    >
    <div class="w-0.5 h-12 bg-linear-to-b from-brand-primary to-transparent">
    </div>
  </div>
</section>
