---
// Components
import Typography from "@/components/atoms/Typography.astro";
import Button from "@/components/atoms/Button.astro";
import OptimizedImage from "@/components/atoms/OptimizedImage.astro";
// Data
import profileData from "@/data/profile.json";
// Assets
import profileImage from "@/assets/images/profile.webp";
import cvUrl from "@/assets/pdf/Alan Francisco Mora Gonzalez - Curriculum.pdf";
---

<section class="max-w-6xl mx-auto px-6 py-24 md:py-32">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
    <div class="md:col-span-7 space-y-6">
      <Typography
        variant="label"
        className="text-brand-primary uppercase tracking-widest block"
      >
        {profileData.subtitle}
      </Typography>

      <Typography variant="h1" className="leading-tight">
        Creación de{" "}
        <span class="text-gradient block md:inline">
          Soluciones Digitales
        </span>.
      </Typography>

      <div class="space-y-4">
        {
          profileData.bio.map((paragraph: string) => (
            <Typography
              variant="body"
              className="max-w-xl text-base leading-relaxed"
            >
              {paragraph}
            </Typography>
          ))
        }
      </div>

      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <Button href={cvUrl} variant="cta" size="lg" shape="lg" target="_blank">
          Descargar CV
        </Button>
        <Button
          href={profileData.social.find(
            (s: { name: string; url: string }) => s.name === "GitHub",
          )?.url || "#"}
          variant="ghost"
          size="lg"
          shape="lg"
          target="_blank"
        >
          Ver Github
        </Button>
      </div>
    </div>

    <div class="md:col-span-5 relative">
      <div
        class="aspect-square rounded-2xl overflow-hidden glass-card ghost-border rotate-2 hover:rotate-0 transition-transform duration-500 shadow-[0_0_30px_rgba(0,218,243,0.1)]"
      >
        <OptimizedImage
          src={profileImage}
          alt={profileData.name}
          class="w-full h-full object-cover"
        />
      </div>
      <div
        class="absolute -bottom-6 -left-6 glass-card p-6 rounded-xl hidden md:block ghost-border"
      >
        <Typography variant="label-muted" className="text-brand-tertiary">
          Estatus: {profileData.status}
        </Typography>
        <Typography variant="body" className="text-brand-text font-bold">
          {profileData.location}
        </Typography>
      </div>
    </div>
  </div>
</section>
