---
// Components
import Typography from "@/components/atoms/Typography.astro";
---

<header class="mb-16">
  <div class="max-w-3xl">
    <Typography
      variant="h1"
      className="mb-6 text-brand-primary tracking-tighter"
    >
      Full Portfolio
    </Typography>
    <Typography
      variant="body"
      className="text-brand-textMuted text-lg leading-relaxed"
    >
      A curated archive of technical engineering challenges, architectural
      experiments, and creative coding sessions. From high-concurrency Node.js
      systems to immersive 3D WebGL experiences, every project represents a leap
      forward in my journey as a sophisticated architect of the digital web.
    </Typography>
  </div>
</header>
