---
// Images
import logoImage from "@/assets/images/logotipo.webp";

// Components
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import OptimizedImage from "@/components/atoms/OptimizedImage.astro";
import Anchor from "@/components/atoms/Anchor.astro";

const navItems = [
  { label: "Experiencia", href: "experience" },
  { label: "Proyectos", href: "projects" },
];
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-brand-background/80 backdrop-blur-lg border-b border-brand-border/20 shadow-sm"
>
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <Anchor href="/" className="flex items-center group">
      <OptimizedImage
        src={logoImage}
        alt="AlanCoding Logo"
        class="h-10 w-auto object-contain hover:scale-105 transition-transform"
      />
    </Anchor>

    <nav class="hidden md:flex items-center gap-8">
      {
        navItems.map((item) => (
          <Anchor
            href={item.href}
            className="font-inter text-sm font-medium text-brand-textMuted hover:text-brand-primary transition-colors"
          >
            {item.label}
          </Anchor>
        ))
      }
      <Button href="#contact" variant="cta" size="sm" shape="pill">
        Contáctame
      </Button>
    </nav>

    <div class="md:hidden flex items-center">
      <button
        class="text-brand-primary hover:text-brand-primaryCyan"
        aria-label="Menu"
      >
        <Icon name="lucide:menu" size="lg" />
      </button>
    </div>
  </div>
</header>
