---
import { Image } from 'astro:assets';
import logoImage from '../../assets/images/logotipo.webp';

const navItems = [
  { label: 'Experiencia', href: 'experience' },
  { label: 'Proyectos', href: 'projects' },
];
---

<header class="fixed top-0 left-0 w-full z-50 bg-brand-background/80 backdrop-blur-lg border-b border-brand-border/20 shadow-sm">
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center group">
      <Image src={logoImage} alt="AlanCoding Logo" class="h-10 w-auto object-contain hover:scale-105 transition-transform" />
    </a>
    
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map(item => (
        <a href={item.href} class="font-inter text-base font-medium text-brand-textMuted hover:text-brand-primary transition-colors">
          {item.label}
        </a>
      ))}
      <a href="#contact" class="px-6 py-2 rounded-full cyan-orange-gradient text-brand-surface font-bold active:scale-95 transition-transform hover:shadow-[0_0_15px_rgba(0,218,243,0.3)]">
        Contáctame
      </a>
    </nav>
    
    <div class="md:hidden flex items-center">
      <button class="text-brand-primary hover:text-brand-primaryCyan" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
