---
import projectsData from "@/data/projects.json";

const categories = Array.from(new Set(projectsData.map((p) => p.category)));

const categoryLabels: Record<string, string> = {
  "web-app": "Web App",
  webgl: "3D / WebGL",
  mobile: "Mobile",
  ai: "AI",
  fullstack: "Fullstack",
  web3: "Web3",
};

const formatLabel = (c: string) =>
  categoryLabels[c] || c.charAt(0).toUpperCase() + c.slice(1).replace("-", " ");
---

<div class="flex flex-wrap gap-4 mb-12 items-center" id="projects-filter">
  <span
    class="font-mono text-xs text-brand-outline uppercase tracking-widest mr-2"
    >Filtrar por:</span
  >
  <button
    class="filter-btn active font-mono text-sm px-6 py-2 rounded-full border border-brand-border/30 hover:border-brand-primary/50 transition-all text-brand-text"
    data-filter="all"
  >
    Todos
  </button>
  {
    categories.map((category) => (
      <button
        class="filter-btn font-mono text-sm px-6 py-2 rounded-full border border-brand-border/30 hover:border-brand-primary/50 transition-all text-brand-text"
        data-filter={category}
      >
        {formatLabel(category)}
      </button>
    ))
  }
</div>

<style>
  /* Use Tailwind colors via classes inside the script for the active state, or a CSS variable approach. */
  /* For simplicity, applying custom styles matching Tailwind theme */
  .filter-btn.active {
    background-color: #00daf3; /* brand-primary */
    color: #0c0e12; /* brand-surfaceContainerLowest */
    border-color: #00daf3;
  }
</style>
