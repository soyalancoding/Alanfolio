---
// Components
import Typography from "@/components/atoms/Typography.astro";
import Button from "@/components/atoms/Button.astro";

// Data
import projectsData from "@/data/projects.json";

const categories = Array.from(new Set(projectsData.map((p) => p.category)));

const categoryLabels: Record<string, string> = {
  "web-app": "Web App",
  webgl: "3D / WebGL",
  game: "Juegos",
  mobile: "Aplicaciones Móviles",
  ai: "Inteligencia Artificial",
  fullstack: "Fullstack",
  web3: "Web3",
};

const formatLabel = (c: string) =>
  categoryLabels[c] || c.charAt(0).toUpperCase() + c.slice(1).replace("-", " ");
---

<div class="flex flex-wrap gap-4 mb-12 items-center" id="projects-filter">
  <Typography
    variant="span"
    className="font-mono text-xs text-brand-outline uppercase tracking-widest mr-2"
  >
    Filtrar por:
  </Typography>
  <Button
    variant="filter"
    size="sm"
    shape="pill"
    className="filter-btn active"
    data-filter="all"
  >
    Todos
  </Button>
  {
    categories.map((category) => (
      <Button
        variant="filter"
        size="sm"
        shape="pill"
        className="filter-btn"
        data-filter={category}
      >
        {formatLabel(category)}
      </Button>
    ))
  }
</div>
