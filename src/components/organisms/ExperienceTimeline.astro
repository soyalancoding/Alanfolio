---
// Components
import ExperienceItem from "@/components/molecules/ExperienceItem.astro";
import Typography from "@/components/atoms/Typography.astro";
// Data
import experienceData from "@/data/experience.json";

interface Props {
  showFullDetails?: boolean;
}

const { showFullDetails = false } = Astro.props;
---

<section class="py-16 md:py-32 px-6" id="experience">
  <div class="max-w-4xl mx-auto">
    <Typography variant="h2" className="mb-16 flex items-center gap-4">
      <span class="w-12 h-px bg-brand-primary"></span>
      Experiencia profesional
    </Typography>

    <div class="relative pl-8 md:pl-0">
      <!-- Vertical Timeline Line -->
      <div
        class="absolute left-0.75 md:left-1/2 md:-translate-x-1/2 top-0 bottom-0 w-0.5 timeline-line"
      >
      </div>

      {
        experienceData.map(
          (
            exp: {
              role: string;
              company: string;
              period: string;
              description: string;
              extendedDescription?: string;
            },
            index: number,
          ) => (
            <ExperienceItem
              role={exp.role}
              company={exp.company}
              period={exp.period}
              description={exp.description}
              extendedDescription={exp.extendedDescription}
              showFullDetails={showFullDetails}
              isLeft={index % 2 !== 0}
            />
          ),
        )
      }
    </div>
  </div>
</section>
