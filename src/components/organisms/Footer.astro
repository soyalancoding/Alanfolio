---
// Components
import Typography from "@/components/atoms/Typography.astro";
import OptimizedImage from "@/components/atoms/OptimizedImage.astro";
// Data
import profileData from "@/data/profile.json";
// Assets
import logoImage from "@/assets/images/logotipo.webp";
import cvUrl from "@/assets/pdf/Alan Francisco Mora Gonzalez - Curriculum.pdf";

const currentYear = new Date().getFullYear();
---

<footer
  class="w-full bg-brand-surfaceContainerLowest border-t border-brand-border/10"
>
  <div
    class="flex flex-col md:flex-row justify-between items-center py-12 px-6 max-w-6xl mx-auto"
  >
    <div class="mb-8 md:mb-0">
      <div class="mb-4 flex items-center">
        <OptimizedImage
          src={logoImage}
          alt="AlanCoding Logo"
          class="h-10 w-auto object-contain"
        />
      </div>
      <Typography
        variant="label"
        className="text-brand-textMuted normal-case tracking-normal"
      >
        &copy; {currentYear}, {profileData.name}. Trabajemos juntos. Contáctame.
      </Typography>
    </div>

    <div class="flex items-center gap-8 font-mono text-sm">
      {
        profileData.social.map((link: { name: string; url: string }) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-textMuted hover:text-brand-secondary transition-opacity hover:opacity-80"
          >
            {link.name}
          </a>
        ))
      }
      <a
        href={cvUrl}
        class="text-brand-textMuted hover:text-brand-secondary transition-opacity hover:opacity-80"
        target="_blank"
      >
        Curriculum
      </a>
    </div>
  </div>
</footer>
