---
// Components
import ProjectCard from "@/components/molecules/ProjectCard.astro";
import Typography from "@/components/atoms/Typography.astro";
import Icon from "@/components/atoms/Icon.astro";
// Data
import projectsData from "@/data/projects.json";

// Interfaces
interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const projects = limit ? projectsData.slice(0, limit) : projectsData;
---

<section
  class="py-16 md:py-32 bg-brand-surfaceContainerLowest/50 px-6"
  id="projects"
>
  <div class="max-w-6xl mx-auto">
    <div
      class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6"
    >
      <div>
        <Typography variant="h2" className="mb-4">
          Poyectos destacados
        </Typography>
        <Typography variant="body" className="max-w-xl">
          Una selección de desafíos de ingeniería y experimentos creativos que
          he abordado recientemente.
        </Typography>
      </div>
      <a
        class="text-brand-primary flex items-center gap-2 hover:underline font-medium"
        href="/projects"
      >
        Ver todos los proyectos
        <Icon name="lucide:arrow-right" size="base" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.title}
            shortDescription={project.shortDescription}
            imageUrl={project.imageUrl}
            slug={project.slug}
            techStack={project.techStack}
          />
        ))
      }
    </div>
  </div>
</section>
