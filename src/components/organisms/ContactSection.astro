---
// Components
import Typography from "@/components/atoms/Typography.astro";
import Button from "@/components/atoms/Button.astro";
import FormField from "@/components/molecules/FormField.astro";
// Data
import portfolioData from "@/data/portfolio.json";

const { profile } = portfolioData;
---

<section class="py-20 md:py-32 px-6" id="contact">
  <div class="max-w-6xl mx-auto">
    <div
      class="glass-card rounded-2xl p-8 md:p-16 flex flex-col md:flex-row gap-16 relative overflow-hidden ghost-border"
    >
      <!-- Subtle Glow -->
      <div
        class="absolute -top-24 -right-24 w-64 h-64 bg-brand-primary/20 blur-[100px] rounded-full"
      >
      </div>

      <div class="md:w-1/2">
        <Typography variant="h2" className="mb-6">
          Let's Build Something <span class="text-gradient">Iconic</span>
        </Typography>
        <Typography variant="body" className="mb-12">
          I'm currently available for freelance projects and high-impact
          engineering roles. If you have an idea that needs technical
          excellence, let's talk.
        </Typography>

        <div class="space-y-6">
          <div class="flex items-center gap-4 group">
            <div
              class="w-12 h-12 rounded-lg bg-brand-surfaceHighlight flex items-center justify-center text-brand-primary border border-brand-border/50 group-hover:cyan-orange-gradient group-hover:text-brand-surface transition-all"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                  d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
              >
            </div>
            <div>
              <Typography variant="label-muted">Email</Typography>
              <Typography variant="body" className="font-bold text-brand-text"
                >{profile.email}</Typography
              >
            </div>
          </div>
          <div class="flex items-center gap-4 group">
            <div
              class="w-12 h-12 rounded-lg bg-brand-surfaceHighlight flex items-center justify-center text-brand-primary border border-brand-border/50 group-hover:cyan-orange-gradient group-hover:text-brand-surface transition-all"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
            </div>
            <div>
              <Typography variant="label-muted">Location</Typography>
              <Typography variant="body" className="font-bold text-brand-text"
                >{profile.location}</Typography
              >
            </div>
          </div>
        </div>
      </div>

      <div class="md:w-1/2 relative z-10">
        <form class="space-y-6" onsubmit="event.preventDefault()">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <FormField label="Name" placeholder="John Doe" />
            <FormField
              label="Email"
              type="email"
              placeholder="john@example.com"
            />
          </div>
          <FormField
            label="Message"
            type="textarea"
            placeholder="Tell me about your project..."
            rows={4}
          />
          <Button
            type="submit"
            variant="cta"
            size="lg"
            shape="lg"
            className="w-full"
          >
            Send Message
          </Button>
        </form>
      </div>
    </div>
  </div>
</section>
