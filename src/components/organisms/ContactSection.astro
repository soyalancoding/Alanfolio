---
// Components
import Typography from "@/components/atoms/Typography.astro";
import Button from "@/components/atoms/Button.astro";
import FormField from "@/components/molecules/FormField.astro";
import Icon from "@/components/atoms/Icon.astro";

// Data
import profileData from "@/data/profile.json";

const profile = profileData;
---

<section class="py-20 md:py-32 px-6" id="contact">
  <div class="max-w-6xl mx-auto">
    <div
      class="glass-card rounded-2xl p-8 md:p-16 flex flex-col md:flex-row gap-16 relative overflow-hidden ghost-border"
    >
      <!-- Subtle Glow -->
      <div
        class="absolute -top-24 -right-24 w-64 h-64 bg-brand-primary/20 blur-[100px] rounded-full"
      >
      </div>

      <div class="md:w-1/2">
        <Typography variant="h2" className="mb-6">
          Construyamos algo <Typography variant="span" className="text-gradient"
            >icónico</Typography
          >
        </Typography>
        <Typography variant="body" className="mb-12">
          Estoy actualmente disponible para proyectos freelance y roles de
          ingeniería de alto impacto. Si tienes una idea que necesita excelencia
          técnica, hablemos.
        </Typography>

        <div class="space-y-6">
          <div class="flex items-center gap-4 group">
            <div
              class="w-12 h-12 rounded-lg bg-brand-surfaceHighlight flex items-center justify-center text-brand-primary border border-brand-border/50 group-hover:cyan-orange-gradient group-hover:text-brand-surface transition-all"
            >
              <Icon name="lucide:mail" size="md" />
            </div>
            <div>
              <Typography variant="label-muted">Empresa</Typography>
              <Typography variant="body" className="font-bold text-brand-text">
                {profile.work}
              </Typography>
            </div>
          </div>
          <div class="flex items-center gap-4 group">
            <div
              class="w-12 h-12 rounded-lg bg-brand-surfaceHighlight flex items-center justify-center text-brand-primary border border-brand-border/50 group-hover:cyan-orange-gradient group-hover:text-brand-surface transition-all"
            >
              <Icon name="lucide:map-pin" size="md" />
            </div>
            <div>
              <Typography variant="label-muted">Ubicación</Typography>
              <Typography variant="body" className="font-bold text-brand-text">
                {profile.location}
              </Typography>
            </div>
          </div>
        </div>
      </div>

      <div class="md:w-1/2 relative z-10">
        <form class="space-y-6" onsubmit="event.preventDefault()">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <FormField label="Nombre" placeholder="Alan Doe" />
            <FormField
              label="Correo"
              type="email"
              placeholder="johndoe@mail.com"
            />
          </div>
          <FormField
            label="Mensaje"
            type="textarea"
            placeholder="Háblame de tu proyecto..."
            rows={4}
          />
          <Button
            type="submit"
            variant="cta"
            size="lg"
            shape="lg"
            className="w-full"
          >
            Enviar Mensaje
          </Button>
        </form>
      </div>
    </div>
  </div>
</section>
