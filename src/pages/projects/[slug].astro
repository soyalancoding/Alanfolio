---
// Layouts
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/organisms/Header.astro";
import Footer from "@/components/organisms/Footer.astro";

// Organisms
import ProjectHero from "@/components/organisms/ProjectHero.astro";
import ProjectOverview from "@/components/organisms/ProjectOverview.astro";
import ProjectInnovations from "@/components/organisms/ProjectInnovations.astro";
import ProjectResults from "@/components/organisms/ProjectResults.astro";
import ProjectNextCTA from "@/components/organisms/ProjectNextCTA.astro";

// Data
import projectsData from "@/data/projects.json";

export function getStaticPaths() {
  return projectsData.map((project, index) => {
    const nextProject = projectsData[index + 1] || projectsData[0]; // Loop to first project if it's the last one

    return {
      params: { slug: project.slug },
      props: { project, nextProject },
    };
  });
}

const { project, nextProject } = Astro.props;
---

<BaseLayout title={`${project.title} | AlanCoding`}>
  <Header />

  <main class="min-h-screen relative overflow-hidden bg-brand-background">
    <ProjectHero project={project} />
    <ProjectOverview project={project} />
    <ProjectInnovations project={project} />
    <ProjectResults project={project} />
    <ProjectNextCTA nextProject={nextProject} />
  </main>

  <Footer />
</BaseLayout>
