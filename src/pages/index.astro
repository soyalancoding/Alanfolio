---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/organisms/Header.astro";
import HeroSection from "../components/organisms/HeroSection.astro";
import ExperienceTimeline from "../components/organisms/ExperienceTimeline.astro";
import ProjectGrid from "../components/organisms/ProjectGrid.astro";
import ContactSection from "../components/organisms/ContactSection.astro";
import Footer from "../components/organisms/Footer.astro";
---

<BaseLayout title="AlanCoding">
  <Header />

  <main>
    <HeroSection />
    <ExperienceTimeline />
    <ProjectGrid limit={3} />
    <ContactSection />
  </main>

  <Footer />
</BaseLayout>
